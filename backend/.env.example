SUPABASE_URL=https://nlfalrpuspdezfnlakrv.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Odds APIs ─────────────────────────────────────────────────────────────────
SGO_API_KEY=your_sgo_key_here
ODDS_API_KEY=your_odds_api_key_here

# Primary source: sgo (recommended) or toa
ODDS_PRIMARY_SOURCE=sgo

# ── The Odds API thresholds ───────────────────────────────────────────────────
# Free=500 | Starter=500 | 20K plan=20000 | etc. — set to YOUR plan's monthly credits
TOA_MONTHLY_QUOTA=20000         # YOUR PLAN: 20K credits @ $30/mo
TOA_RESERVE=500                 # keep 500 in reserve (~12 full MLB+WC snapshots)
TOA_MAINLINES_MIN=100           # fetch mainlines when 100+ credits remain
TOA_PROPS_MIN=1000              # fetch props when 1000+ remain (TOA is fallback, be generous)
TOA_PROPS_RESERVE=10            # per-game prop guard
TOA_MAX_CREDITS_PER_SNAPSHOT=150  # 20K plan can afford fuller TOA fallbacks

# ── SportsGameOdds thresholds (Amateur / free — no paid plan yet) ─────────────
SGO_MONTHLY_OBJECTS=2500       # Amateur free; upgrade to Rookie when you scale users
SGO_RESERVE=200                # stop polling when objects remaining below
SGO_RATE_LIMIT_PER_MIN=10        # Amateur free tier

# ── Polling schedule ──────────────────────────────────────────────────────────
# SGO free + 18-game slate: 360min poll ≈ 72 objects/day ≈ 2,160/month (safe)
# TOA 20K is NOT used for continuous polling — SGO primary, TOA fallback only
ODDS_PRIMARY_SOURCE=sgo
ODDS_POLL_INTERVAL_MINUTES=360   # SGO free: every 6 hours
AGENT_SCAN_INTERVAL_MINUTES=30   # reads cache — no extra API cost
SNAPSHOT_MAX_AGE_MINUTES=360     # match poll interval

# Daily 8:40 AM MT — morning TOA snapshot before 8:50 WC card (~39 credits/day)
TOA_MORNING_SNAPSHOT=true
# Max cache age (minutes) before WC card triggers a fresh TOA pull at 8:50 AM
WC_ODDS_MAX_AGE_MINUTES=45

TIMEZONE=America/Denver
FRONTEND_URL=https://your-vercel-url.vercel.app

# ── World Cup daily card (Railway APScheduler @ 8:50 AM MT) ───────────────────
WC_CARD_ENABLED=true
WC_CARD_USER_EMAIL=austin.noyes21@gmail.com

# ── Email delivery (WC card + legacy ESM cards) ───────────────────────────────
EMAIL_FROM=cards@edgebet.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_gmail@gmail.com
EMAIL_SMTP_PASS=your_gmail_app_password

# ── Google Sheets bet tracker sync ────────────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_SYNC_EMAIL=austin.noyes21@gmail.com
